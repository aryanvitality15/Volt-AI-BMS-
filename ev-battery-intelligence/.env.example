# EV BATTERY INTELLIGENCE — ENVIRONMENT CONFIGURATION

# --- Server & Host Settings ---
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# --- Database Persistence ---
# For local development or Render with persistent disk:
DATABASE_PATH=backend/battery_intelligence.db
# For PostgreSQL integration (if using hosted Supabase, Neon, or RDS):
# DATABASE_URL=postgresql://user:password@host:5432/volt_bms

# --- Authentication & Security ---
# Secret key used for session signing and cryptographic salts:
AUTH_SECRET_KEY=volt-neural-bms-engineering-secret-key-2026-prod
SESSION_EXPIRY_HOURS=720

# --- HiveMQ MQTT Broker Integration ---
HIVEMQ_HOST=broker.hivemq.com
HIVEMQ_PORT=1883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
MQTT_TOPIC_BASE=ev/battery

# --- Primary Default Pack Settings ---
BATTERY_ID=EV-001
NUM_CELLS=8
RATED_CAPACITY_AH=40.0
CHEMISTRY=LFP
NOMINAL_CELL_VOLTAGE=3.2
MAX_CELL_VOLTAGE=3.65
MIN_CELL_VOLTAGE=2.80

# --- Simulation & Telemetry Rate ---
SIMULATION_INTERVAL_SEC=1.0
SIMULATOR_SCENARIO=NORMAL

# --- Frontend Vercel Environment Variables ---
# Set these in your Vercel project settings pointing to your Render / VPS backend:
# VITE_API_URL=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com/ws/telemetry
